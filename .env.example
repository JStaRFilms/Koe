# J-Star Code Reviewer
# Required: Gemini API key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# Required: Groq API key for LLM reviews
GROQ_API_KEY=your_groq_api_key_here
# Optional: Override the embedding model
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: Override the default model
# REVIEW_MODEL_NAME=openai/gpt-oss-120b

# Koe website backend / Next API
# Required for Neon-backed account APIs. Keep server-side only.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Optional alias if hosting config prefers this name.
# NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Required for AES-256-GCM BYOK credential encryption.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KOE_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=k1
KOE_CREDENTIAL_ENCRYPTION_KEYS={"k1":"replace_with_base64_32_byte_key"}

# Server-owned Groq key for managed allocation mode and the tightly limited public browser demo.
# Never expose this to desktop/mobile/web clients.
GROQ_MANAGED_API_KEY=your_server_managed_groq_key_here

# Public landing-page browser demo. Uses GROQ_MANAGED_API_KEY server-side, stores no transcript history,
# and is protected by per-IP rate limits plus a short audio cap.
KOE_PUBLIC_DEMO_ENABLED=true
KOE_PUBLIC_DEMO_MAX_AUDIO_SECONDS=30

# Optional first-slice managed free allocation created at signup when explicitly enabled.
KOE_MANAGED_DEFAULT_FREE_ENABLED=false
KOE_MANAGED_DEFAULT_AUDIO_SECONDS=3600
KOE_MANAGED_DEFAULT_REQUESTS=500

# Dynamic managed-free daily quota. Applies to default_free/free_daily managed allocations.
# Formula: clamp((provider daily audio * safety ratio) / active managed users in 24h, guaranteed, bonus ceiling).
KOE_MANAGED_FREE_PROVIDER_DAILY_AUDIO_SECONDS=28800
KOE_MANAGED_FREE_POOL_SAFETY_RATIO=0.70
KOE_MANAGED_FREE_GUARANTEED_SECONDS=300
KOE_MANAGED_FREE_BONUS_CEILING_SECONDS=7200
KOE_MANAGED_FREE_MIN_DAILY_REQUESTS=30
KOE_MANAGED_FREE_MAX_DAILY_REQUESTS=720

# Email verification and password reset emails.
# Create a Resend API key and verified sender/domain before production use.
RESEND_API_KEY=your_resend_api_key_here
KOE_EMAIL_FROM=Koe <noreply@your-domain.example>
KOE_APP_URL=https://your-domain.example

# Optional local/admin dashboard for inspecting users, quotas, and usage.
# Enabled by default in local development; disabled by default in production unless explicitly enabled.
KOE_ADMIN_DASHBOARD_ENABLED=false
# Strongly recommended if enabling the dashboard in any hosted environment.
KOE_ADMIN_DASHBOARD_TOKEN=replace_with_long_random_admin_token

