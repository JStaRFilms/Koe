# J-Star Code Reviewer
# Required: Gemini API key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# Required: Groq API key for LLM reviews
GROQ_API_KEY=your_groq_api_key_here
# Optional: Override the embedding model
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: Override the default model
# REVIEW_MODEL_NAME=openai/gpt-oss-120b

# Koe website backend / Next API
# Required for Neon-backed account APIs. Keep server-side only.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
# Optional alias if hosting config prefers this name.
# NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Required for AES-256-GCM BYOK credential encryption.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KOE_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=k1
KOE_CREDENTIAL_ENCRYPTION_KEYS={"k1":"replace_with_base64_32_byte_key"}

# Server-owned Groq key for managed allocation mode. Never expose to desktop/mobile clients.
GROQ_MANAGED_API_KEY=your_server_managed_groq_key_here

# Optional first-slice managed free allocation created at signup when explicitly enabled.
KOE_MANAGED_DEFAULT_FREE_ENABLED=false
KOE_MANAGED_DEFAULT_AUDIO_SECONDS=3600
KOE_MANAGED_DEFAULT_REQUESTS=500

# Email verification and password reset emails.
# Create a Resend API key and verified sender/domain before production use.
RESEND_API_KEY=your_resend_api_key_here
KOE_EMAIL_FROM=Koe <noreply@your-domain.example>
KOE_APP_URL=https://your-domain.example

